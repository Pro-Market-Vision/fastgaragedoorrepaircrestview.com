---
import Icon from "./Icon.astro";
import { ALL_SERVICES, PHONE_DISPLAY, PHONE_TEL } from "@/data/site";

interface Props {
  variant?: "light" | "dark";
  showServices?: boolean;
}

const { variant = "light", showServices = true } = Astro.props as Props;

const SERVICE_AREA_CITIES = [
  "Crestview", "Baker", "Laurel Hill", "Holt", "Milligan",
  "Niceville", "Valparaiso", "Shalimar", "Eglin AFB",
  "Fort Walton Beach", "Destin",
];

const isDark = variant === "dark";
const sectionBg = isDark ? "bg-[#0F1117] text-white" : "bg-[#F5F5F5] text-[#1D1D1D]";
const cardBg = isDark
  ? "bg-[#1A1D27] border border-white/10"
  : "bg-white border border-[#E5E5E5] shadow-[0_8px_24px_rgba(0,0,0,0.06)]";
const headingColor = isDark ? "text-white" : "text-[#1D1D1D]";
const bodyColor = isDark ? "text-white/80" : "text-[#4D4D4D]";
const labelColor = isDark ? "text-white/60" : "text-[#7A7A7A]";
const cityText = isDark ? "text-white" : "text-[#1D1D1D]";
const linkText = isDark
  ? "text-white/90 hover:text-[#C8102E]"
  : "text-[#1D1D1D] hover:text-[#C8102E]";
const dividerColor = isDark ? "border-white/10" : "border-[#E5E5E5]";
const secondaryBtn = isDark
  ? "bg-transparent text-white border-white hover:bg-white hover:text-[#0F1117]"
  : "bg-transparent text-[#1D1D1D] border-[#1D1D1D] hover:bg-[#1D1D1D] hover:text-white";
---

<section class={`${sectionBg} border-t-4 border-[#C8102E]`}>
  <div class="mx-auto max-w-[1240px] px-5 lg:px-12 py-16 lg:py-20">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-5">
        <div class="font-[Bebas_Neue] text-[18px] uppercase tracking-[0.18em] text-[#C8102E]">Service Area</div>
        <div class="mt-2 mb-5 h-[3px] w-12 bg-[#C8102E]" aria-hidden="true"></div>
        <h2 class={`font-[Bebas_Neue] text-[36px] sm:text-[44px] lg:text-[48px] leading-[1.05] uppercase font-medium ${headingColor}`}>
          Crestview, FL & All of Okaloosa County
        </h2>
        <p class={`mt-5 text-[16px] leading-[26px] ${bodyColor}`}>
          We come to you. Same-day garage door service for homes and businesses across Crestview and the surrounding cities. 100% mobile local techs, free estimates on every job, and live phone answering 24/7.
        </p>
        <p class={`mt-4 text-[15px] leading-[24px] ${bodyColor}`}>
          Whether you're a homeowner with a snapped torsion spring at 7 AM or a property manager with a stuck overhead door at a fleet bay, we dispatch the same day with the parts to fix it on the first visit.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a
            href={`tel:${PHONE_TEL}`}
            class="inline-flex items-center justify-center gap-2 bg-[#C8102E] text-white py-3 px-6 font-[Bebas_Neue] text-[16px] tracking-[0.1em] rounded-full border-2 border-[#C8102E] hover:bg-[#9A0A23] hover:border-[#9A0A23] transition-colors whitespace-nowrap"
          >
            <Icon name="phone" class="h-4 w-4" />
            Call {PHONE_DISPLAY}
          </a>
          <a
            href="/location/crestview/"
            class={`inline-flex items-center justify-center gap-2 py-3 px-6 font-[Bebas_Neue] text-[16px] tracking-[0.1em] rounded-full border-2 transition-colors whitespace-nowrap ${secondaryBtn}`}
          >
            View Service Area
          </a>
        </div>
      </div>

      <div class="lg:col-span-7">
        <div class={`${cardBg} rounded-lg p-6 sm:p-8`}>
          <div class={`font-[Bebas_Neue] text-[14px] uppercase tracking-[0.15em] ${labelColor} mb-4`}>Cities We Cover</div>
          <ul class="grid grid-cols-2 sm:grid-cols-3 gap-x-4 gap-y-2">
            {SERVICE_AREA_CITIES.map((city) => (
              <li class={`flex items-center gap-2 text-[15px] ${cityText}`}>
                <span class="flex h-5 w-5 shrink-0 items-center justify-center bg-[#C8102E] text-white rounded-sm">
                  <Icon name="map-pin" class="h-3 w-3" />
                </span>
                {city}
              </li>
            ))}
          </ul>

          {showServices && (
            <div class={`mt-6 pt-6 border-t ${dividerColor}`}>
              <div class={`font-[Bebas_Neue] text-[14px] uppercase tracking-[0.15em] ${labelColor} mb-3`}>All Services Available in Your Area</div>
              <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-2">
                {ALL_SERVICES.map((s) => (
                  <li>
                    <a href={s.href} class={`flex items-center gap-2 text-[14px] ${linkText} transition-colors`}>
                      <Icon name="arrow-right" class="h-3 w-3 text-[#C8102E] shrink-0" />
                      {s.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</section>
