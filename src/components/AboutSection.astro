---
import PrimaryButton from "./PrimaryButton.astro";
---

<section id="about" class="bg-white">
  <div class="mx-auto max-w-[1240px] px-5 lg:px-12 py-20 lg:py-24 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
    <div class="lg:col-span-5 border-l-4 border-[#C8102E] pl-4">
      <img src="/images/about.jpg" alt="Fast Garage Door Repair &amp; Service Crestview installation" width="952" height="1024" loading="lazy" decoding="async" class="w-full h-auto" />
    </div>
    <div class="lg:col-span-7">
      <div class="font-[Bebas_Neue] text-[20px] uppercase text-[#101010] tracking-wider">About Us</div>
      <div class="mt-2 mb-6 h-[3px] w-12 bg-[#C8102E]" aria-hidden="true"></div>
      <h2 class="font-[Bebas_Neue] text-[36px] sm:text-[44px] lg:text-[48px] leading-[1.05] uppercase text-[#1D1D1D] font-medium">
        Crestview's Trusted Garage Door Repair & Installation Team
      </h2>
      <p class="mt-6 text-[16px] leading-[28px] text-[#7A7A7A]">
        At Fast Garage Door Repair & Service Crestview, we handle every garage door issue homes and businesses face across Okaloosa County. From <a href="/service/garage-door-spring-repair/" class="text-[#C8102E] font-semibold hover:underline">broken spring repair</a> and <a href="/service/garage-door-opener-repair/" class="text-[#C8102E] font-semibold hover:underline">opener repair</a> to brand-new <a href="/service/garage-door-installation/" class="text-[#C8102E] font-semibold hover:underline">garage door installation</a>, our team shows up on time and gives a free quote upfront. Free estimates on every job, call <a href="tel:+18509202243" class="text-[#C8102E] font-semibold hover:underline">(850) 920-2243</a> to schedule.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <PrimaryButton href="/about-us/">About Us</PrimaryButton>
        <PrimaryButton href="#contact">Free Estimate</PrimaryButton>
      </div>
    </div>
  </div>
</section>
