---
import Icon from "./Icon.astro";
import { ALL_SERVICES, PHONE_DISPLAY as DEFAULT_PHONE_DISPLAY, PHONE_TEL as DEFAULT_PHONE_TEL } from "@/data/site";

interface Props {
  phoneDisplay?: string;
  phoneTel?: string;
}

const { phoneDisplay = DEFAULT_PHONE_DISPLAY, phoneTel = DEFAULT_PHONE_TEL } = Astro.props;
const PHONE_DISPLAY = phoneDisplay;
const PHONE_TEL = phoneTel;

const inputClass =
  "w-full bg-white border border-[#E5E5E5] px-[18px] py-[14px] text-[16px] text-[#1D1D1D] placeholder:text-[#9a9a9a] focus:outline-none focus:border-[#C8102E] transition-colors";

const services = ALL_SERVICES;
---

<section id="contact" class="bg-white border-t-4 border-[#C8102E]">
  <div class="mx-auto max-w-[1240px] px-5 lg:px-12 py-20 lg:py-24 grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
    <div class="lg:col-span-5">
      <div class="font-[Bebas_Neue] text-[20px] uppercase tracking-wider text-[#101010]">Contact Us</div>
      <div class="mt-2 mb-6 h-[3px] w-12 bg-[#C8102E]" aria-hidden="true"></div>
      <h2 class="font-[Bebas_Neue] text-[44px] sm:text-[52px] lg:text-[56px] leading-[1.08] uppercase font-medium text-[#1D1D1D]">
        Get a free estimate
      </h2>
      <p class="mt-6 text-[16px] leading-[28px] text-[#7A7A7A]">
        Have a question? Need a quick repair? Want a free estimate? We're here to help with all your garage door needs, fast, friendly, and reliable service is just a call or message away.
      </p>
      <div class="mt-8 space-y-4">
        <a
          href={`tel:${PHONE_TEL}`}
          class="flex w-full sm:w-auto sm:inline-flex items-center justify-center gap-3 bg-[#C8102E] text-white py-4 px-7 font-[Bebas_Neue] text-[20px] tracking-[0.1em] rounded-full border-2 border-[#C8102E] hover:bg-[#9A0A23] hover:border-[#9A0A23] transition-colors whitespace-nowrap"
        >
          <Icon name="phone" class="h-5 w-5" />
          {PHONE_DISPLAY}
        </a>
        <div class="inline-flex items-center gap-3 bg-white border-2 border-[#C8102E] rounded-lg px-4 py-3 text-[16px] font-medium text-[#1D1D1D]">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center bg-[#C8102E] text-white rounded-md">
            <Icon name="map-pin" class="h-4 w-4" />
          </span>
          Servicing Crestview, FL
        </div>
      </div>
    </div>

    <div class="lg:col-span-7">
      <div class="bg-[#F5F5F5] p-8 sm:p-10 border-2 border-[#C8102E]">
        <form
          class="contact-form space-y-5"
          method="post"
          action="/api/contact/"
          aria-label="Contact form"
          novalidate
        >
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <input
              name="FullName"
              required
              placeholder="Full Name *"
              autocomplete="name"
              class={inputClass}
            />
            <input
              name="EmailAddress"
              type="email"
              required
              placeholder="Email *"
              autocomplete="email"
              class={inputClass}
            />
          </div>
          <input
            name="PhoneNumber"
            type="tel"
            required
            inputmode="tel"
            placeholder="XXX-XXX-XXXX *"
            autocomplete="tel"
            maxlength="12"
            class={inputClass}
          />
          {services.length > 0 && (
            <select name="Select Service" class={inputClass} aria-label="Service requested">
              <option value="">Select a service (optional)</option>
              {services.map((s) => (
                <option value={s.title}>{s.title}</option>
              ))}
            </select>
          )}
          <textarea
            name="Message"
            placeholder="Message"
            rows="6"
            class={inputClass}
          ></textarea>

          {/* Honeypot, hidden from real users; bots fill it and the API silently drops the submission */}
          <span class="honeypot-911-wrap" style="display:none !important; visibility:hidden !important;" aria-hidden="true">
            <label for="hp-honeypot-911">Please leave this field empty.</label>
            <input
              id="hp-honeypot-911"
              name="honeypot-911"
              type="text"
              value=""
              tabindex="-1"
              autocomplete="off"
            />
          </span>

          <button
            type="submit"
            class="w-full bg-[#C8102E] text-white py-4 font-[Bebas_Neue] text-[18px] uppercase tracking-[0.18em] rounded-full border-2 border-[#C8102E] hover:bg-[#9A0A23] hover:border-[#9A0A23] transition-colors disabled:opacity-60"
          >
            Send
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
