---
import Icon from "./Icon.astro";
import { COMPANY, PHONE_DISPLAY, PHONE_TEL, ADDRESS, GBP_URL, GBP_CID } from "@/data/site";

const embedSrc = `https://www.google.com/maps?cid=${GBP_CID}&output=embed`;
---

<section aria-label="Service area map" class="bg-[#F5F5F5] border-t-4 border-[#C8102E]">
  <div class="mx-auto max-w-[1240px] px-5 lg:px-12 py-16 lg:py-20">
    <div class="text-center max-w-[820px] mx-auto mb-10">
      <div class="font-[Bebas_Neue] text-[18px] uppercase tracking-[0.18em] text-[#C8102E]">Service Area</div>
      <div class="mx-auto mt-2 mb-4 h-[3px] w-12 bg-[#C8102E]" aria-hidden="true"></div>
      <h2 class="font-[Bebas_Neue] text-[36px] sm:text-[44px] lg:text-[48px] leading-[1.05] uppercase font-medium text-[#1D1D1D]">
        Serving Crestview & Okaloosa County
      </h2>
      <p class="mt-4 text-[16px] leading-[26px] text-[#4D4D4D]">
        Locally owned. We come to you. Same-day appointments across Crestview, Niceville, Baker, Laurel Hill, Eglin AFB, Fort Walton Beach, and the rest of Okaloosa County, FL.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      <div class="lg:col-span-7 rounded-lg overflow-hidden shadow-[0_8px_24px_rgba(0,0,0,0.08)] bg-white">
        <iframe
          src={embedSrc}
          title={`Google Maps, ${COMPANY}`}
          class="w-full h-[360px] sm:h-[420px] lg:h-full block"
          style="min-height: 360px; border:0;"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>

      <div class="lg:col-span-5 bg-white rounded-lg p-7 lg:p-8 shadow-[0_8px_24px_rgba(0,0,0,0.06)] border-l-4 border-[#C8102E] flex flex-col">
        <h3 class="font-[Bebas_Neue] text-[26px] sm:text-[30px] uppercase text-[#1D1D1D] leading-[1.05]">
          {COMPANY}
        </h3>

        <div class="mt-5 space-y-4 text-[15px] leading-[24px] text-[#1D1D1D]">
          <div class="flex items-start gap-3">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center bg-[#C8102E] text-white rounded-md mt-0.5">
              <Icon name="map-pin" class="h-4 w-4" />
            </span>
            <div>
              <div class="font-medium text-[13px] uppercase tracking-wider text-[#7A7A7A]">Mailing Address</div>
              <div class="mt-0.5">{ADDRESS}</div>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center bg-[#C8102E] text-white rounded-md mt-0.5">
              <Icon name="clock" class="h-4 w-4" />
            </span>
            <div>
              <div class="font-medium text-[13px] uppercase tracking-wider text-[#7A7A7A]">Hours</div>
              <div class="mt-0.5">Open 24/7. Same-day & emergency service.</div>
            </div>
          </div>
        </div>

        <div class="mt-7 flex flex-col sm:flex-row gap-3">
          <a
            href={`tel:${PHONE_TEL}`}
            class="inline-flex items-center justify-center gap-2 bg-[#C8102E] text-white py-3 px-5 font-[Bebas_Neue] text-[16px] tracking-[0.1em] rounded-full border-2 border-[#C8102E] hover:bg-[#9A0A23] hover:border-[#9A0A23] transition-colors whitespace-nowrap"
          >
            <Icon name="phone" class="h-4 w-4" />
            Call {PHONE_DISPLAY}
          </a>
          <a
            href={GBP_URL}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center justify-center gap-2 bg-transparent text-[#1D1D1D] py-3 px-5 font-[Bebas_Neue] text-[16px] tracking-[0.1em] rounded-full border-2 border-[#1D1D1D] hover:bg-[#1D1D1D] hover:text-white transition-colors whitespace-nowrap"
          >
            <Icon name="map-pin" class="h-4 w-4" />
            Find Us on Google
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
