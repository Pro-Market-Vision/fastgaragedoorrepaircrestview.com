---
import Layout from "@/layouts/Layout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import InnerHero from "@/components/InnerHero.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ContactSection from "@/components/ContactSection.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import InternalLinksBlock from "@/components/InternalLinksBlock.astro";
import { ALL_SERVICES } from "@/data/site";

const featuredServices = ALL_SERVICES.slice(0, 6).map((s) => ({
  href: s.href,
  label: s.title,
  description: `Read about our ${s.title.toLowerCase()} options and pricing.`,
}));

const POSTS: { title: string; excerpt: string; href: string; image: string; date: string; dateDisplay: string }[] = [
  {
    title: "Best Garage Door Openers for 2026: Buyer's Guide for Crestview Homeowners",
    excerpt: "Compare the best garage door openers for 2026: LiftMaster, Chamberlain, Genie. Smart Wi-Fi features, belt vs chain vs jackshaft, and what Crestview homeowners actually need.",
    href: "/blog/best-garage-door-openers-2026/",
    image: "/images/services/garage-door-opener-repair-1.jpg",
    date: "2026-04-15",
    dateDisplay: "April 15, 2026",
  },
];
---

<Layout
  title="Garage Door Tips & Guides | Fast Garage Door Repair Crestview"
  description="Garage door buyer's guides, repair walkthroughs, and seasonal tips from local Crestview techs. Springs, openers, installs, and emergency fixes across Okaloosa County."
>
  <SiteHeader />
  <main class="flex-1">
    <InnerHero title="Our Blog" kicker="Tips &amp; Insights" />
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Blog" }]} />

    <section class="bg-white">
      <div class="mx-auto max-w-[1240px] px-5 lg:px-12 py-20 lg:py-24">
        <p class="text-center max-w-[700px] mx-auto text-[16px] leading-[28px] text-[#7A7A7A]">
          Practical tips and repair guides on garage doors, springs, openers, and overhead-door care, from a local Crestview team.
        </p>
        {POSTS.length > 0 ? (
          <div class="mt-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {POSTS.map((post) => (
              <article class="bg-white shadow-[0_4px_16px_rgba(0,0,0,0.05)] flex flex-col overflow-hidden rounded-lg border border-[#E5E5E5]">
                <a href={post.href} class="block aspect-[3/2] overflow-hidden">
                  <img src={post.image} alt={post.title} width="900" height="600" loading="lazy" decoding="async" class="h-full w-full object-cover hover:scale-105 transition-transform duration-500" />
                </a>
                <div class="p-6 flex flex-col flex-1">
                  <div class="text-[12px] uppercase tracking-[0.12em] text-[#7A7A7A] font-[Bebas_Neue]">
                    <time datetime={post.date}>{post.dateDisplay}</time>
                  </div>
                  <h3 class="mt-2 font-[Bebas_Neue] text-[22px] leading-[1.15] text-[#1D1D1D]">
                    <a href={post.href} class="hover:text-[#C8102E]">{post.title}</a>
                  </h3>
                  <p class="mt-3 text-[15px] leading-[26px] text-[#7A7A7A] flex-1">{post.excerpt}</p>
                  <a href={post.href} class="mt-4 inline-flex items-center gap-1 text-[13px] font-medium uppercase tracking-wider text-[#C8102E] hover:gap-2 transition-all">Read More →</a>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="mt-10 text-center max-w-[600px] mx-auto bg-[#F5F5F5] border-2 border-[#C8102E] rounded-lg p-8">
            <h3 class="font-[Bebas_Neue] text-[26px] text-[#1D1D1D]">New posts coming soon</h3>
            <p class="mt-3 text-[15px] leading-[26px] text-[#4D4D4D]">We're putting together a series of garage door buyer's guides, repair walk-throughs, and seasonal maintenance checklists. Check back soon, or call us with any question in the meantime.</p>
          </div>
        )}
      </div>
    </section>

    <InternalLinksBlock
      kicker="From the Workshop"
      heading="Featured Services to Explore"
      intro="While you're here, take a look at our most popular garage door services."
      links={featuredServices}
      columns={3}
    />

    <ContactSection />
  </main>
  <SiteFooter />
</Layout>
